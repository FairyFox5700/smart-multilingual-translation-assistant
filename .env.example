# Azure AI Translator credentials
# Resource key auth (simplest to start)
TRANSLATOR_KEY=
TRANSLATOR_REGION=
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Optional: Microsoft Foundry deployment for LLM-based translation (tone/gender/adaptive)
FOUNDRY_ENDPOINT=
FOUNDRY_KEY=
FOUNDRY_DEPLOYMENT=gpt-5.1

# App settings
APP_ENV=development
CACHE_TTL_SECONDS=3600
